# Rail: mock (default, no Razorpay account required) | razorpay (only after you have your own Test Mode keys)
PAYMENT_RAIL=mock

BOUND_DB=./bound.db
CART_TTL_SECONDS=90
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Next.js rewrite target. Local default is 127.0.0.1:8000. On Vercel set this
# to the public FastAPI host (Railway / Render / Fly). Build-time on Vercel.
# BOUND_API_URL=https://your-api-host.example

# Extra browser origins for CORS, comma-separated. Localhost is already allowed.
# Preview hosts matching https://*.vercel.app are already allowed.
# CORS_ORIGINS=https://your-app.vercel.app

# Leave the next three unset until you have legitimate Razorpay Test Mode credentials
# that you created on your own Dashboard. Do not paste anyone else's keys.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional: buyer-agent LLM only. Never used for authorization or settlement.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
